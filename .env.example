# LLM provider — `anthropic` (direct API) or `poe` (Poe's OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required if LLM_PROVIDER=poe — get one at https://poe.com/api_key
POE_API_KEY=
POE_DRAFTING_BOT=Claude-Opus-4.7
# Use a search-capable bot for discovery (Claude-Opus-4.7-Search, Web-Search,
# Perplexity-Sonar-Large, etc.). If you set this to a model without web access,
# scout falls back to whatever the model knows from training data — useless.
POE_SCOUT_BOT=Claude-Opus-4.7-Search
# Cheaper bot for raw-finding normalisation; falls back to drafting bot on
# malformed JSON. Sonnet-class is plenty for structured extraction.
POE_NORMALISER_BOT=Claude-Sonnet-4.6

# Optional: Tavily fallback for non-agent web searches
TAVILY_API_KEY=

# LLM defaults
SCOUT_MODEL=claude-opus-4-7
SCOUT_EFFORT=high

# Cost guardrails (hard caps per scout run)
SCOUT_MAX_WEB_SEARCHES=25
SCOUT_MAX_INPUT_TOKENS=200000
SCOUT_MAX_OUTPUT_TOKENS=50000

# Scheduling — weekly cron (default Mondays 07:00 local)
SCOUT_CRON_DAY_OF_WEEK=mon
SCOUT_CRON_HOUR=7
SCOUT_CRON_MINUTE=0

# Paths (defaults are fine for local dev)
SCOUT_DATA_DIR=./data
SCOUT_PROMPTS_DIR=./prompts
SCOUT_DB_PATH=./data/scout.db

# Logging
SCOUT_LOG_LEVEL=INFO
SCOUT_LOG_JSON_PATH=./data/scout.log
